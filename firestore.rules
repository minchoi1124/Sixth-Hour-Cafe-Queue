/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @Core Philosophy:
 * This ruleset provides public read access to drinks, categories, and orders, but restricts write access. Anyone can read the drink menu, category list, or list of orders. Write access to drinks and categories is forbidden, simulating a read-only menu and category structure for all users, including unauthenticated users. Anyone can create orders, representing customers submitting their orders, but orders cannot be modified or deleted.
 *
 *
 * @Data Structure:
 * - /drinks/{drinkId}: Stores individual drink menu items. Public read access. Write access is forbidden.
 * - /orders/{orderId}: Stores customer orders. Public read access. Anyone can create an order, but orders cannot be modified or deleted.
 * - /categories/{categoryId}: Stores drink categories. Public read access. Write access is forbidden.
 *
 * @Key Security Decisions:
 * - Public Read Access: Drinks, categories, and orders are publicly readable to allow open access to the menu and order history.
 * - No User Roles: The application uses anonymous authentication, so there are no user-specific roles.
 * - Write Restrictions: Only order creation is allowed. Drinks and categories cannot be created, updated, or deleted.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to drinks and denies all write access.
     * @path /drinks/{drinkId}
     * @allow (get, list): Any user can read drink information.
     * @deny (create, update, delete): No user can create, update, or delete drink information.
     * @principle Allows public read access but restricts all writes.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read and create access to orders, but denies update and delete access.
     * @path /orders/{orderId}
     * @allow (get, list, create): Any user can read orders and create new orders.
     * @deny (update, delete): No user can update or delete existing orders.
     * @principle Allows public order creation and read access, but prevents modifications and deletions.
     */
    match /orders/{orderId} {
      allow get, list, create: if true;
      allow update, delete: if false;
    }

    /**
     * @description Grants public read access to categories and denies all write access.
     * @path /categories/{categoryId}
     * @allow (get, list): Any user can read category information.
     * @deny (create, update, delete): No user can create, update, or delete category information.
     * @principle Allows public read access but restricts all writes.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to categories and denies all write access.
     * @path /categories/{categoryId}
     * @allow (get, list): Any user can read category information.
     * @deny (create, update, delete): No user can create, update, or delete category information.
     * @principle Allows public read access but restricts all writes.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}