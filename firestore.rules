rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A cafe is owned by the user whose uid equals the cafe document id.
    function isOwner(cafeId) {
      return request.auth != null && request.auth.uid == cafeId;
    }

    // Validates a customer-submitted order. Customers are anonymous, so this is
    // the only place the order shape is enforced. App Check guards against bots.
    function isValidNewOrder() {
      let data = request.resource.data;
      return data.keys().hasOnly(['customerName', 'items', 'createdAt', 'status'])
        && data.status == 'pending'
        && data.customerName is string
        && data.customerName.size() >= 1
        && data.customerName.size() <= 60
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 25
        && data.createdAt == request.time;
    }

    match /cafes/{cafeId} {
      // Menu/cafe info is public so customers can view it without an account.
      allow read: if true;
      allow create, update, delete: if isOwner(cafeId);

      match /drinks/{drinkId} {
        allow read: if true;
        allow create, update, delete: if isOwner(cafeId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if isOwner(cafeId);
      }

      match /counters/{counterId} {
        allow read: if true;
        allow create, update, delete: if isOwner(cafeId);
      }

      match /orders/{orderId} {
        // Anyone may place an order, but only the owner may read or manage them.
        allow create: if isValidNewOrder();
        allow read, update, delete: if isOwner(cafeId);
      }
    }

    // Public slug -> cafe lookup. A signed-in owner may claim a slug for their
    // own cafe exactly once; slugs are never reassigned (no update/delete).
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cafeId'])
        && request.resource.data.cafeId == request.auth.uid;
      allow update, delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
