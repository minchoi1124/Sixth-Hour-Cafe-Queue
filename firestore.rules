rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A cafe is owned by the user whose uid equals the cafe document id.
    function isOwner(cafeId) {
      return request.auth != null && request.auth.uid == cafeId;
    }

    // A staff member has a userCafes/{uid} doc pointing at this cafe.
    function isStaff(cafeId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/userCafes/$(request.auth.uid))
        && get(/databases/$(database)/documents/userCafes/$(request.auth.uid)).data.cafeId == cafeId;
    }

    // Owners and staff may both work the queue and manage the menu.
    function canManage(cafeId) {
      return isOwner(cafeId) || isStaff(cafeId);
    }

    match /cafes/{cafeId} {
      // Menu/cafe info is public so customers can view it without an account.
      allow read: if true;
      // Cafe settings (location, slug, instagram, timezone) are owner-only, but
      // staff work the queue and so must be able to start and end sessions and
      // set today's menu — which means `activeSessionId` and `liveMenu`, and
      // nothing else, on this doc. `liveMenu` is the public mirror the
      // unauthenticated ordering page reads, since sessions are staff-only.
      allow create, delete: if isOwner(cafeId);
      allow update: if isOwner(cafeId)
        || (isStaff(cafeId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activeSessionId', 'liveMenu']));

      match /drinks/{drinkId} {
        allow read: if true;
        allow create, update, delete: if canManage(cafeId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if canManage(cafeId);
      }

      // A session is one pop-up service, with its stats frozen on end.
      // Staff-only: customers never need to see them.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if canManage(cafeId);
      }

      // Named, reusable menus that sessions snapshot from. Staff-only —
      // customers read the active menu from the cafe doc's `liveMenu` mirror.
      match /presets/{presetId} {
        allow read, create, update, delete: if canManage(cafeId);
      }

      // How to make each drink, keyed by drink id. Staff-only and deliberately
      // NOT world-readable, unlike `drinks`: customers see the description, the
      // people making it see the ingredients and steps.
      match /recipes/{drinkId} {
        allow read, create, update, delete: if canManage(cafeId);
      }

      match /orders/{orderId} {
        // Orders are created only by the server (Admin SDK via /api/orders, which
        // verifies an App Check token). Client-side creates are denied; owners and
        // staff read and manage them.
        allow create: if false;
        allow read, update, delete: if canManage(cafeId);
      }

      // Owner-only private data (e.g. the current invite code).
      match /private/{doc} {
        allow read, write: if isOwner(cafeId);
      }
    }

    // Public slug -> cafe lookup. A signed-in owner may claim a slug pointing to
    // their own cafe, and may release a slug they own (used when changing links).
    // Slugs are never edited in place — to change a link, delete + create.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cafeId'])
        && request.resource.data.cafeId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.cafeId == request.auth.uid;
      allow update: if false;
    }

    // Invite code -> cafe lookup. Anyone signed in can resolve a code they know
    // (get by id), but codes can't be listed/enumerated. Only the owner manages
    // codes for their own cafe.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['cafeId'])
        && request.resource.data.cafeId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.cafeId == request.auth.uid;
    }

    // Staff membership. A user joins by creating their own doc, but only with a
    // valid invite code that maps to the target cafe. The cafe owner can list and
    // remove their staff; a user can read/remove their own membership.
    match /userCafes/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource.data.cafeId == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cafeId', 'role', 'email', 'code', 'joinedAt'])
        && request.resource.data.role == 'staff'
        && request.resource.data.email == request.auth.token.email
        && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code)).data.cafeId == request.resource.data.cafeId;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || resource.data.cafeId == request.auth.uid);
      allow update: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
