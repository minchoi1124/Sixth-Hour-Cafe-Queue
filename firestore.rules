/**
 * @fileoverview Firestore Security Rules for the Coffee Ordering App.
 *
 * Core Philosophy:
 * This ruleset allows any signed-in user (including anonymous users) to read all data but restricts modifications (create, update, delete) to authenticated users only.
 * It does not enforce a strict ownership model.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Publicly readable drink menu items.
 * - /orders/{orderId}: Orders placed by customers.
 * - /categories/{categoryId}: Publicly readable drink categories.
 *
 * Key Security Decisions:
 * - Allows anonymous authentication to enable order submission without requiring account creation.
 * - Permits anyone to create orders.
 * - Does not allow listing orders - should not be generally accessible.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to drink menu items and allows anyone to create orders.
     * @path /drinks/{drinkId}
     * @allow (get, list) Any user can read drink information.
     * @deny (create, update, delete) No one can modify drink information.
     * @principle Grants public read access.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows any signed-in user to create orders. Orders cannot be listed.
     * @path /orders/{orderId}
     * @allow (create) Any authenticated user can create an order.
     * @deny (get, list, update, delete) Orders should not be generally accessible.
     * @principle Allows order submission by authenticated users.
     */
    match /orders/{orderId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    
    /**
     * @description Grants public read access to drink categories.
     * @path /categories/{categoryId}
     * @allow (get, list) Any user can read category information.
     * @deny (create, update, delete) No one can modify category information.
     * @principle Grants public read access.
     */
    match /categories/{categoryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}