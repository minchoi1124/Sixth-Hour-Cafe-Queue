rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Two kinds of people work a location:
    //  - the owner, who signs in with an account and has
    //    locations/{locationId}/members/{uid} with role 'owner';
    //  - staff, who have no account: /api/staff-signin signs their device in
    //    with a custom token naming the location and its passcode version (see
    //    src/lib/staff-passcode.ts). Changing the passcode bumps `staffPasscodeVersion` on the
    //    location, which makes every older staff sign-in stop working.
    function memberPath(locationId) {
      return /databases/$(database)/documents/locations/$(locationId)/members/$(request.auth.uid);
    }

    function isOwner(locationId) {
      return request.auth != null
        && exists(memberPath(locationId))
        && get(memberPath(locationId)).data.role == 'owner';
    }

    function isPasscodeStaff(locationId) {
      return request.auth != null
        && request.auth.token.get('staffLocation', null) == locationId
        && request.auth.token.get('staffPasscodeVersion', -1)
             == get(/databases/$(database)/documents/locations/$(locationId)).data.get('staffPasscodeVersion', 0);
    }

    // Owner as of the end of the current batch/transaction. Lets onboarding
    // create the location, the owner's membership and the slug in one write.
    function isOwnerAfter(locationId) {
      return request.auth != null
        && getAfter(memberPath(locationId)).data.role == 'owner';
    }

    // Owners and staff may both work the queue and manage the menu.
    function canManage(locationId) {
      return isOwner(locationId) || isPasscodeStaff(locationId);
    }

    match /locations/{locationId} {
      // Menu/cafe info is public so customers can view it without an account.
      allow read: if true;
      // Created by onboarding in the same write as the founder's owner
      // membership. Holds nothing private: it's world-readable, so who owns it
      // lives in `members`, which isn't.
      allow create: if isOwnerAfter(locationId);
      allow delete: if isOwner(locationId);
      // Settings (location, slug, instagram, timezone, staffPasscodeVersion) are
      // owner-only, but staff work the queue and so must be able to start and
      // end sessions and set today's menu — which means `activeSessionId` and
      // `liveMenu`, and nothing else, on this doc. `liveMenu` is the public
      // mirror the unauthenticated ordering page reads, since sessions are
      // staff-only.
      allow update: if isOwner(locationId)
        || (isPasscodeStaff(locationId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activeSessionId', 'liveMenu']));

      match /drinks/{drinkId} {
        allow read: if true;
        allow create, update, delete: if canManage(locationId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if canManage(locationId);
      }

      // A session is one pop-up service, with its stats frozen on end.
      // Staff-only: customers never need to see them.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      // Named, reusable menus that sessions snapshot from. Staff-only —
      // customers read the active menu from the cafe doc's `liveMenu` mirror.
      match /presets/{presetId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      // How to make each drink, keyed by drink id. Staff-only and deliberately
      // NOT world-readable, unlike `drinks`: customers see the description, the
      // people making it see the ingredients and steps.
      match /recipes/{drinkId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      match /orders/{orderId} {
        // Orders are created only by the server (Admin SDK via /api/orders, which
        // verifies an App Check token). Client-side creates are denied; owners and
        // staff read and manage them.
        allow create: if false;
        allow read, update, delete: if canManage(locationId);
      }

      // Owner-only private data: the staff passcode (`staffPasscode`, kept readable so
      // the owner can share it). The order counter and the wrong-passcode counter
      // also live here but are written only by the server.
      match /private/{doc} {
        allow read, write: if isOwner(locationId);
      }

      // The owner's account. Anyone can read their own membership (login
      // resolves it). Docs with role 'staff' are left over from the old invite
      // system and grant nothing.
      match /members/{uid} {
        allow read: if isOwner(locationId)
          || (request.auth != null && request.auth.uid == uid);
        // The founding owner, only in the same write that creates the location.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'role', 'joinedAt'])
          && request.resource.data.role == 'owner'
          && request.resource.data.email == request.auth.token.get('email', null)
          && !exists(/databases/$(database)/documents/locations/$(locationId))
          && existsAfter(/databases/$(database)/documents/locations/$(locationId));
        // An owner can't remove themselves, which would strand the location
        // with nobody in charge.
        allow update, delete: if false;
      }
    }

    // Public slug -> location lookup. An owner may claim a slug pointing to
    // their own location, and may release one they own (used when changing
    // links). Slugs are never edited in place — to change a link, delete + create.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['locationId'])
        && isOwnerAfter(request.resource.data.locationId);
      allow delete: if isOwner(resource.data.locationId);
      allow update: if false;
    }

    // Which location an owner's account belongs to. Only a pointer — access
    // comes from the member doc, which must exist (by the end of the write) for
    // the pointer to be accepted. `lastSeenUpdate` is the newest "What's new"
    // entry the account has dismissed (src/lib/updates.ts). Staff devices have
    // no pointer and remember that on the device instead.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['locationId', 'role', 'email', 'lastSeenUpdate'])
        && (!('lastSeenUpdate' in request.resource.data)
            || (request.resource.data.lastSeenUpdate is string
                && request.resource.data.lastSeenUpdate.size() <= 100))
        && request.resource.data.role == 'owner'
        && getAfter(/databases/$(database)/documents/locations/$(request.resource.data.locationId)/members/$(uid)).data.role
             == 'owner';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
