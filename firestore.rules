/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset prioritizes rapid prototyping and assumes a trusted development environment.  All authenticated users are granted full read and write access to all data.  This is NOT suitable for production and MUST be replaced with a more restrictive security model before launch.
 * @data_structure Data is organized into three top-level collections: /drinks/{drinkId}, /orders/{orderId}, and /categories/{categoryId}.
 * @key_security_decisions All authenticated users can read and write any document.
 * @denormalization None.
 * @structural_segregation None.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants all authenticated users full access to all drinks.
     * @path /drinks/{drinkId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation on any drink.
     * @deny (none)
     * @principle Allows any authenticated user to read and write all drinks for rapid prototyping.
     */
    match /drinks/{drinkId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Grants all authenticated users full access to all orders.
     * @path /orders/{orderId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation on any order.
     * @deny (none)
     * @principle Allows any authenticated user to read and write all orders for rapid prototyping.
     */
    match /orders/{orderId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Grants all authenticated users full access to all categories.
     * @path /categories/{categoryId}
     * @allow (get, list, create, update, delete) - Any authenticated user can perform any operation on any category.
     * @deny (none)
     * @principle Allows any authenticated user to read and write all categories for rapid prototyping.
     */
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}