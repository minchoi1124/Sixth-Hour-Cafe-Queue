/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, restricting access unless explicitly allowed.
 * It assumes an anonymous auth context, requiring all write operations to be explicitly permitted.
 * In this prototyping phase, schema validation is relaxed to allow for rapid iteration.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Stores drink menu items.
 * - /orders/{orderId}: Stores customer orders.
 * - /categories/{categoryId}: Stores drink categories.
 *
 * Key Security Decisions:
 * - All write operations require authentication.
 * - Data type validation is omitted for faster prototyping, except for fields directly
 *   involved in authorization and relational integrity.
 * - Listing of documents is generally allowed unless explicitly denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants read access to all users and restricts write access to authenticated users for drinks.
     * @path /drinks/{drinkId}
     * @allow (get, list): Anyone can read drink information.
     * @allow (create): Authenticated user can create a drink.
     * @deny (create): Unauthenticated user cannot create a drink.
     * @deny (update, delete): Only the creator can update or delete a drink.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants read access to all users and restricts write access to authenticated users for orders.
     * @path /orders/{orderId}
     * @allow (get, list): Anyone can read order information.
     * @allow (create): Authenticated user can create a order.
     * @deny (create): Unauthenticated user cannot create a order.
     * @deny (update, delete): Only the creator can update or delete a order.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Grants read access to all users and restricts write access to authenticated users for categories.
     * @path /categories/{categoryId}
     * @allow (get, list): Anyone can read category information.
     * @allow (create): Authenticated user can create a category.
     * @deny (create): Unauthenticated user cannot create a category.
     * @deny (update, delete): Only the creator can update or delete a category.
     * @principle Allows public read access, restricts writes to authenticated users.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Helper function to determine if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}