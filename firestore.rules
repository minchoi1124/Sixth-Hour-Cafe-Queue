/**
 * @fileoverview Firestore Security Rules for the Coffee Ordering App.
 *
 * Core Philosophy:
 * This ruleset prioritizes security and data protection, enforcing strict access controls based on authentication and authorization.
 * It is configured to allow unauthenticated users to read all available documents, but disallows writing.
 *
 * Data Structure:
 * The data is organized into three top-level collections: 'drinks', 'orders', and 'categories'.
 *  - /drinks/{drinkId}: Stores individual drink menu items.
 *  - /orders/{orderId}: Stores customer orders submitted through the app.
 *  - /categories/{categoryId}: Stores drink categories.
 *
 * Key Security Decisions:
 *  - Public Read Access: 'drinks' and 'categories' are publicly readable to allow unauthenticated users to view the menu and available categories.
 *  - No Write Access: No users, even authenticated ones, have write access to the database in this current configuration.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the drink menu, but restricts creation, updates, and deletes.
     * @path /drinks/{drinkId}
     * @allow (get, list) Allows any user (authenticated or not) to read the drink menu.
     * @deny (create, update, delete) Prevents any user from creating, updating, or deleting drinks.
     * @principle Allows public read access while restricting write access.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts all access to the orders collection.
     * @path /orders/{orderId}
     * @allow None. All operations are denied.
     * @deny All operations are denied.
     * @principle No one is authorized to interact with orders in this configuration.
     */
    match /orders/{orderId} {
      allow get, list, create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read the drink categories, but restricts creation, updates, and deletes.
     * @path /categories/{categoryId}
     * @allow (get, list) Allows any user (authenticated or not) to read the drink categories.
     * @deny (create, update, delete) Prevents any user from creating, updating, or deleting categories.
     * @principle Allows public read access while restricting write access.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}