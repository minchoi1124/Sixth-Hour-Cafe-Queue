/**
 * @fileoverview Firestore Security Rules for the Coffee Ordering App.
 *
 * Core Philosophy:
 * This ruleset prioritizes security and data ownership, allowing unauthenticated users to read drink menus while restricting order creation and management.
 * Categories can be added by anyone but not modified or deleted for data integrity.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Stores drink menu items. Publicly readable.
 * - /orders/{orderId}: Stores customer orders. Only accessible with valid authentication.
 * - /categories/{categoryId}: Stores drink categories. Publicly readable, create-only by anyone.
 *
 * Key Security Decisions:
 * - Unauthenticated users are permitted to read drink and category information to view the menu.
 * - Only authenticated users can create orders. Orders cannot be modified or deleted after creation.
 * - Listing of orders is denied to all users.
 * - Categories can be created by anyone but not updated or deleted to maintain a consistent menu structure.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read the list of available drinks. Only allows create operations
     * @path /drinks/{drinkId}
     * @allow (get, list): Anyone can read drink information to view the menu.
     * @allow (create): Not applicable.
     * @deny (create, update, delete): No write operations are allowed.
     * @principle Public read access for menu items.
     */
    match /drinks/{drinkId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts order access to authenticated users and prevents listing orders.
     * @path /orders/{orderId}
     * @allow (create): Authenticated users can create orders.
     * @deny (get, list, update, delete): No read, list, update, or delete operations are allowed.
     * @principle: Authenticated users can create orders, but cannot view or modify them after submission.
     */
    match /orders/{orderId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

        /**
         * @description Allows anyone to read categories and add new categories, but prevents modification or deletion.
         * @path /categories/{categoryId}
         * @allow (get, list): Anyone can read category information.
         * @allow (create): Anyone can create categories
         * @deny (update, delete): No update or delete operations allowed.
         * @principle: Public read access for categories and allows anyone to create categories, but protects existing categories from modification.
         */
        match /categories/{categoryId} {
            allow get: if true;
            allow list: if true;
            allow create: if true;
            allow update: if false;
            allow delete: if false;
        }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
  }
}