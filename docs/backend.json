{
  "entities": {
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Represents a customer's order including their name and selected drinks.",
      "properties": {
        "customerName": {
          "type": "string",
          "description": "The name of the customer who placed the order."
        },
        "items": {
          "type": "array",
          "description": "An array of items in the order.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "oatMilk": {
                "type": "boolean"
              }
            },
            "required": ["id", "name", "oatMilk"]
          }
        },
        "createdAt": {
          "type": "string",
          "description": "The time the order was submitted.",
          "format": "date-time"
        },
        "status": {
            "type": "string",
            "enum": ["pending", "completed", "archived"]
        }
      },
      "required": [
        "customerName",
        "items",
        "createdAt",
        "status"
      ]
    },
    "Drink": {
      "title": "Drink",
      "type": "object",
      "description": "Represents a drink available on the menu.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the drink (e.g., Maple Matcha Latte)."
        },
        "description": {
          "type": "string",
          "description": "A short description of the drink."
        },
        "category": {
          "type": "string",
          "description": "The category of the drink (e.g., Lattes)."
        },
        "inStock": {
          "type": "boolean",
          "description": "Indicates whether the drink is currently in stock."
        },
        "oatMilkAvailable": {
          "type": "boolean",
          "description": "Indicates whether oat milk is an available modification for this drink."
        },
        "order": {
          "type": "number",
          "description": "The display order of the drink."
        }
      },
      "required": [
        "name",
        "description",
        "category",
        "inStock",
        "oatMilkAvailable",
        "order"
      ]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "description": "Represents a drink category.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the category (e.g., Lattes)."
        }
      },
      "required": ["name"]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/drinks/{drinkId}": {
      "schema": {
        "$ref": "#/entities/Drink"
      },
      "description": "Stores individual drink menu items."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/Order"
      },
      "description": "Stores customer orders submitted through the app."
    },
    "/categories/{categoryId}": {
        "schema": {
            "$ref": "#/entities/Category"
        },
        "description": "Stores drink categories."
    }
  }
}
