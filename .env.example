# Firebase web config values used by the app for local development and Vercel deployments.
# Copy this file to .env.local and replace the placeholder values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Secret for the scheduled cleanup cron (Vercel sends it as a Bearer token).
# Generate any random string. When set, /api/cron/cleanup rejects requests
# without a matching Authorization header.
CRON_SECRET=

# Firebase Admin SDK service account (for server-side Firestore reads).
# In the Firebase console → Project Settings → Service accounts → Generate new private key.
# Paste the entire JSON content as a single line (minified). Required in production.
FIREBASE_SERVICE_ACCOUNT=

# Optional: Firebase App Check (reCAPTCHA v3) site key. When set, App Check is
# enabled in the browser to protect public order creation from bots. Leave blank
# for local development. Create a key in the Firebase console → App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
