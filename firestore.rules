rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access to a location is decided by one doc:
    // locations/{locationId}/members/{uid}, with role 'owner' or 'staff'.
    function memberPath(locationId) {
      return /databases/$(database)/documents/locations/$(locationId)/members/$(request.auth.uid);
    }

    function isMember(locationId) {
      return request.auth != null && exists(memberPath(locationId));
    }

    function isOwner(locationId) {
      return isMember(locationId) && get(memberPath(locationId)).data.role == 'owner';
    }

    // Owner as of the end of the current batch/transaction. Lets onboarding
    // create the location, the owner's membership and the slug in one write.
    function isOwnerAfter(locationId) {
      return request.auth != null
        && getAfter(memberPath(locationId)).data.role == 'owner';
    }

    // Owners and staff may both work the queue and manage the menu.
    function canManage(locationId) {
      return isMember(locationId);
    }

    match /locations/{locationId} {
      // Menu/cafe info is public so customers can view it without an account.
      allow read: if true;
      // Created by onboarding in the same write as the founder's owner
      // membership. Holds nothing private: it's world-readable, so who owns it
      // lives in `members`, which isn't.
      allow create: if isOwnerAfter(locationId);
      allow delete: if isOwner(locationId);
      // Settings (location, slug, instagram, timezone) are owner-only, but
      // staff work the queue and so must be able to start and end sessions and
      // set today's menu — which means `activeSessionId` and `liveMenu`, and
      // nothing else, on this doc. `liveMenu` is the public mirror the
      // unauthenticated ordering page reads, since sessions are staff-only.
      allow update: if isOwner(locationId)
        || (isMember(locationId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['activeSessionId', 'liveMenu']));

      match /drinks/{drinkId} {
        allow read: if true;
        allow create, update, delete: if canManage(locationId);
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow create, update, delete: if canManage(locationId);
      }

      // A session is one pop-up service, with its stats frozen on end.
      // Staff-only: customers never need to see them.
      match /sessions/{sessionId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      // Named, reusable menus that sessions snapshot from. Staff-only —
      // customers read the active menu from the cafe doc's `liveMenu` mirror.
      match /presets/{presetId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      // How to make each drink, keyed by drink id. Staff-only and deliberately
      // NOT world-readable, unlike `drinks`: customers see the description, the
      // people making it see the ingredients and steps.
      match /recipes/{drinkId} {
        allow read, create, update, delete: if canManage(locationId);
      }

      match /orders/{orderId} {
        // Orders are created only by the server (Admin SDK via /api/orders, which
        // verifies an App Check token). Client-side creates are denied; owners and
        // staff read and manage them.
        allow create: if false;
        allow read, update, delete: if canManage(locationId);
      }

      // Owner-only private data (e.g. the current invite code).
      match /private/{doc} {
        allow read, write: if isOwner(locationId);
      }

      // Everyone with access to this location. Owners see and manage the whole
      // roster; anyone can read their own membership (login resolves it).
      match /members/{uid} {
        allow read: if isOwner(locationId)
          || (request.auth != null && request.auth.uid == uid);
        // The founding owner, only in the same write that creates the location.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'role', 'joinedAt'])
          && request.resource.data.role == 'owner'
          && request.resource.data.email == request.auth.token.get('email', null)
          && !exists(/databases/$(database)/documents/locations/$(locationId))
          && existsAfter(/databases/$(database)/documents/locations/$(locationId));
        // Staff joining themselves with a valid invite code for this location.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'role', 'code', 'joinedAt'])
          && request.resource.data.role == 'staff'
          && request.resource.data.email == request.auth.token.get('email', null)
          && exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code))
          && get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.code)).data.locationId == locationId;
        // Owners remove staff; staff may leave. An owner can't remove
        // themselves, which would strand the location with nobody in charge.
        allow delete: if (isOwner(locationId) && request.auth.uid != uid)
          || (request.auth != null && request.auth.uid == uid && resource.data.role != 'owner');
        allow update: if false;
      }
    }

    // Public slug -> location lookup. An owner may claim a slug pointing to
    // their own location, and may release one they own (used when changing
    // links). Slugs are never edited in place — to change a link, delete + create.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['locationId'])
        && isOwnerAfter(request.resource.data.locationId);
      allow delete: if isOwner(resource.data.locationId);
      allow update: if false;
    }

    // Invite code -> location lookup. Anyone signed in can resolve a code they
    // know (get by id), but codes can't be listed/enumerated. Only owners manage
    // codes for their own location.
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['locationId'])
        && isOwner(request.resource.data.locationId);
      allow delete: if isOwner(resource.data.locationId);
    }

    // Which location an account belongs to. Only a pointer — access comes from
    // the member doc, which must exist (by the end of the write) for the
    // pointer to be accepted. Overwriting is allowed so someone removed from
    // one location can join another. `lastSeenUpdate` is the newest "What's
    // new" entry the account has dismissed (src/lib/updates.ts).
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isOwner(resource.data.locationId));
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['locationId', 'role', 'email', 'lastSeenUpdate'])
        && (!('lastSeenUpdate' in request.resource.data)
            || (request.resource.data.lastSeenUpdate is string
                && request.resource.data.lastSeenUpdate.size() <= 100))
        && getAfter(/databases/$(database)/documents/locations/$(request.resource.data.locationId)/members/$(uid)).data.role
             == request.resource.data.role;
      allow delete: if request.auth != null
        && (request.auth.uid == uid || isOwner(resource.data.locationId));
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
