/**
 * @fileoverview Firestore Security Rules for the drink ordering application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to drinks and categories, allowing all users to view the menu.
 * Orders can be created by anyone, but modification and deletion are disallowed to prevent tampering with order history.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Stores information about individual drinks. Publicly readable.
 * - /orders/{orderId}: Stores customer order data. Creatable by any authenticated user, but not updatable or deletable.
 * - /categories/{categoryId}: Stores drink categories. Publicly readable.
 *
 * Key Security Decisions:
 * - Public Read Access: The 'drinks' and 'categories' collections are readable by anyone.
 * - Orders are Immutable: Orders can be created, but not updated or deleted.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to drinks and allows anyone to create orders.
     * @path /drinks/{drinkId}
     * @allow get, list: Anyone can read the drinks menu.
     * @allow create: Not applicable (no creation allowed at this path).
     * @deny update, delete: No updates or deletes allowed to drinks.
     * @principle Public read access for menu items.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to create an order, but prohibits modification or deletion.
     * @path /orders/{orderId}
     * @allow create: Any authenticated user can create an order.
     * @allow get: Any authenticated user can read an order.
     * @allow list: Any authenticated user can list orders.
     * @deny update, delete: Orders cannot be modified or deleted.
     * @principle Orders are immutable after creation.
     */
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to drink categories.
     * @path /categories/{categoryId}
     * @allow get, list: Anyone can read the drink categories.
     * @allow create: Not applicable (no creation allowed at this path).
     * @deny update, delete: No updates or deletes allowed to categories.
     * @principle Public read access for drink categories.
     */
    match /categories/{categoryId} {
        allow get, list: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
    }


    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}