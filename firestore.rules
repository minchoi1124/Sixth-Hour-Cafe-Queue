/**
 * @fileoverview Firestore Security Rules for the coffee ordering application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security and data access control. It leverages Firebase Authentication
 * to manage user identities and restricts data access based on user roles and ownership.
 * It uses a flexible data model that is designed for rapid iteration, but is still secure by only allowing anonymous access to some of the data.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Stores publicly readable drink menu items.
 * - /orders/{orderId}: Stores customer orders. Anonymous users can create orders.
 * - /categories/{categoryId}: Stores publicly readable drink categories.
 *
 * Key Security Decisions:
 * - Listing orders is disallowed to prevent unauthorized access to order data.
 * - Drink and Category data is publicly readable, which is great for quickly prototyping the UI.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /****************** DRINKS COLLECTION ******************/

    /**
     * @description Allows public read access to drink menu items. Write access is denied.
     * @path /drinks/{drinkId}
     * @allow (get, list): Any user can read drink information.
     * @deny (create, update, delete): No user can create, update, or delete drinks through client-side rules.
     * @principle Allows public read access for menu items while restricting write access.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /****************** ORDERS COLLECTION ******************/

    /**
     * @description Allows anonymous users to create orders, but restricts reading, updating, and deleting orders.
     * @path /orders/{orderId}
     * @allow (create): Any anonymous user can create an order.
     * @deny (get, list, update, delete): No user can get, list, update, or delete orders through client-side rules.
     * @principle Allows order submission while preventing unauthorized data access.
     */
    match /orders/{orderId} {
      allow create: if isSignedIn() == false;
      allow get, update, delete: if false;
      allow list: if false;
    }

    /****************** CATEGORIES COLLECTION ******************/

    /**
     * @description Allows public read access to drink categories. Write access is denied.
     * @path /categories/{categoryId}
     * @allow (get, list): Any user can read drink category information.
     * @deny (create, update, delete): No user can create, update, or delete categories through client-side rules.
     * @principle Allows public read access for drink categories while restricting write access.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}