/**
 * @fileoverview Firestore Security Rules for the Coffee Ordering App.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access by enforcing strict public read access and preventing unauthorized data manipulation.
 *
 * Data Structure:
 * - /drinks/{drinkId}: Stores individual drink menu items. Accessible for public reads.
 * - /orders/{orderId}: Stores customer orders. Accessible for public reads, writes are disallowed.
 * - /categories/{categoryId}: Stores drink categories. Accessible for public reads.
 *
 * Key Security Decisions:
 * - Public Read Access: All collections (/drinks, /orders, /categories) are publicly readable to allow for easy data fetching without authentication.
 * - No Write Access: No write access is granted to any user, including authenticated users, on the Orders collection in this prototype to prevent unauthorized changes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to drink menu items.
     * @path /drinks/{drinkId}
     * @allow (get, list): Any user can read drink details.
     * @deny (create, update, delete): No users can create, update, or delete drinks.
     * @principle Allows public read access for fetching menu items, but restricts write access.
     */
    match /drinks/{drinkId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to customer orders.
     * @path /orders/{orderId}
     * @allow (get, list): Any user can read order details.
     * @deny (create, update, delete): No users can create, update, or delete orders.
     * @principle Allows public read access for displaying orders, but restricts write access to prevent unauthorized changes.
     */
    match /orders/{orderId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to drink categories.
     * @path /categories/{categoryId}
     * @allow (get, list): Any user can read category details.
     * @deny (create, update, delete): No users can create, update, or delete categories.
     * @principle Allows public read access for fetching drink categories, but restricts write access.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}